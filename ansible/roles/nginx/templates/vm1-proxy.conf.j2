upstream app_backend {
    server 172.30.0.12:80 max_fails=2 fail_timeout=5s;
    server 172.30.0.13:80 max_fails=2 fail_timeout=5s;
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;

    server_name public.vm1.local;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name public.vm1.local;

    ssl_certificate /etc/nginx/ssl/public.vm1.local.crt;
    ssl_certificate_key /etc/nginx/ssl/public.vm1.local.key;

    location /vm2 {
        proxy_pass http://172.30.0.12/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /vm3 {
        proxy_pass http://172.30.0.13/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /app {
        proxy_pass http://app_backend/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location / {
        default_type text/plain;
        return 200 "Hostname: $hostname\nTime: $time_iso8601\n";
    }
}
